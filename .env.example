# ── LLM providers ────────────────────────────────────────────────
# All optional — presence enables that provider in Settings model selects
# (spec §2.1). At least one key (or FAKE_LLM_ENABLED=1) is needed for runs.
# First boot picks default_model from whichever providers are configured:
# anthropic → google flash → openai 5.6 luna → fake (spec §13).
# ./quick-setup.sh prompts per provider and verifies keys before saving.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: 1 enables the scriptable fake provider for keyless demos/tests (spec §11)
FAKE_LLM_ENABLED=

# ── Database ─────────────────────────────────────────────────────
# Used by docker-compose to init the db container
POSTGRES_USER=agentorchestrator
POSTGRES_PASSWORD=agentorchestrator
POSTGRES_DB=agentorchestrator
# Used by the backend (asyncpg driver; host `db` inside compose, `localhost` outside)
DATABASE_URL=postgresql+asyncpg://agentorchestrator:agentorchestrator@db:5432/agentorchestrator

# ── Observability (all optional) ─────────────────────────────────
# LangSmith: key only — enable/endpoint/project are runtime settings in the UI (spec §10)
LANGSMITH_API_KEY=
# OTel: bootstrap default; the otlp_endpoint app setting overrides at runtime
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── App ──────────────────────────────────────────────────────────
# Sandbox root for the seeded filesystem MCP server (mounted volume)
WORKSPACE_DIR=/workspace
# optional: enables the 'redis' registry-cache mode (spec §7.3); url-with-credentials stays env-only
REDIS_URL=
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Frontend → backend base URL (Vite build-time)
VITE_API_BASE_URL=http://localhost:8000

# ── §18.4 ambient delivery channels (all optional; email/webhook stay dark unless set)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# webhook push channel: one JSON envelope per delivery batch (SMS/push-gateway shape)
AMBIENT_WEBHOOK_URL=

# ── §18.7 custom OpenAI-compatible gateway (optional; enables the 'custom' provider)
CUSTOM_GATEWAY_BASE_URL=
CUSTOM_GATEWAY_API_KEY=
# comma-separated model ids — this env list IS the provider's validated model list
CUSTOM_GATEWAY_MODELS=

# ── §18.8 auth & tenancy (dark by default: false ⇒ byte-identical single-user)
AUTH_ENABLED=false
# bearer-session lifetime in hours when auth is on (M40)
AUTH_SESSION_TTL_H=24
# CORS pin when auth is on (e.g. http://localhost:5173)
FRONTEND_ORIGIN=
